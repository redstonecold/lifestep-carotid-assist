<View>
  <Header value="경동맥 내강만 다각형으로 표시 (정맥은 칠하지 않음)"/>
  <Image name="image" value="$image" zoom="true" zoomControl="true" brightnessControl="true" contrastControl="true" rotateControl="false"/>
  <PolygonLabels name="lumen" toName="image" strokeWidth="2" pointSize="small" opacity="0.35">
    <Label value="경동맥 내강" background="#FF3B30"/>
  </PolygonLabels>
  <Header value="세트 (필수) — 여러 개에 해당하면 더 나쁜 쪽 (F &gt; C &gt; B &gt; A)"/>
  <Choices name="grade" toName="image" choice="single" required="true" showInline="true">
    <Choice value="A" hint="위·아래 벽의 내벽 흰 띠까지 선명, 혈관이 화면 좌우 끝까지 이어짐 → 보이는 내강을 화면 끝까지 그림"/>
    <Choice value="B" hint="내강은 보이지만 내벽 흰 띠가 안 보이거나 흐림 → 보이는 내강을 그림"/>
    <Choice value="C" hint="위·아래 벽은 보이지만 혈관이 화면 중간에서 끝나거나 끊김 → 보이는 내강만 그림"/>
    <Choice value="F" hint="위·아래 벽 중 한쪽이 안 보이거나 경동맥이 아예 안 보임(횡단면·탐촉자 이동) → 확실한 내강만 그림, 없으면 그리지 않음"/>
    <Choice value="X" hint="동맥·정맥 구분을 확신할 수 없음 → 제외(다각형 그리지 않음)"/>
  </Choices>
  <View visibleWhen="choice-selected" whenTagName="grade" whenChoiceValue="X">
    <Header value="X 제외 사유"/>
    <Choices name="exclude_reason" toName="image" choice="single">
      <Choice value="동맥·정맥 구분 불가"/>
      <Choice value="다른 혈관과 구분 불가"/>
      <Choice value="기타(메모에 기록)"/>
    </Choices>
  </View>
  <TextArea name="note" toName="image" placeholder="메모(선택)" rows="2" maxSubmissions="1"/>
</View>
